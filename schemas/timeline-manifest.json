{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/timeline-manifest.json",
  "title": "TimelineManifest",
  "description": "An editor-neutral timeline manifest: media references + timing only. It is NOT a renderer and contains no rendered media.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "format": {
      "type": "string",
      "enum": [
        "otio_candidate",
        "editor_neutral_v1"
      ]
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "title"
            ]
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clip_id": {
                  "type": "string"
                },
                "media": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/\\-]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "media_type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "additionalProperties": false
                },
                "in_seconds": {
                  "type": "number",
                  "minimum": 0
                },
                "out_seconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "clip_id",
                "media"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "track_id",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "loudness_profile_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "format",
    "tracks"
  ],
  "additionalProperties": false
}
