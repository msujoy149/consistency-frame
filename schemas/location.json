{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/location.json",
  "title": "Location",
  "description": "A location record, tracked by stable ID for continuity across scenes/episodes.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/\\-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "scene_episode_usage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity_notes": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "name",
    "version",
    "status"
  ],
  "additionalProperties": false
}
