{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/approval.json",
  "title": "Approval",
  "description": "An approval / rights / consent / retention record. Permanent registration is invalid without an approved record of this type.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "character",
        "voice_profile",
        "sound_asset",
        "project",
        "skill_change",
        "release",
        "export"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "pending"
      ]
    },
    "consent": {
      "type": "object",
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "granted_by": {
          "type": "string"
        },
        "granted_at": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "rights_holder",
            "licence",
            "unknown"
          ]
        }
      },
      "required": [
        "granted",
        "source"
      ],
      "additionalProperties": false
    },
    "rights_note": {
      "type": "string"
    },
    "retention": {
      "type": "string",
      "enum": [
        "temporary",
        "project",
        "permanent_registered"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "subject_type",
    "subject_id",
    "decision",
    "consent"
  ],
  "additionalProperties": false
}
