{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/reference-review.json",
  "title": "ReferenceReview",
  "description": "A reference review: analysis + timecoded findings only. It must NOT mutate canonical skills (mutates_canonical_skills is always false).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "reference_id": {
      "type": "string"
    },
    "reference_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timecode": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "global",
              "project",
              "character",
              "scene",
              "shot"
            ]
          }
        },
        "required": [
          "observation"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "string"
    },
    "mutates_canonical_skills": {
      "type": "boolean",
      "enum": [
        false
      ]
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "reference_id",
    "mutates_canonical_skills"
  ],
  "additionalProperties": false
}
