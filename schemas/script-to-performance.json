{"$id":"https://consistencyframe.blogspot.com/schemas/v2.4/script-to-performance.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Script-to-Performance contract (v2.4 headline deliverable, also filed as SCRIPT_TO_PERFORMANCE_SCHEMA.json). One record binds a script to its Scene Plan, Shot Plan and Performance Plan, plus the audio and editing plans. RULE: the user's original dialogue is preserved verbatim unless rewriting was explicitly requested \u2014 dialogue_mode VERBATIM_SCRIPT with dialogue_rewrite_authorised false is the default, and a rewrite needs an explicit user request. Performance direction never changes the words.","properties":{"audio_plan":{"additionalProperties":false,"properties":{"ambience":{"items":{"additionalProperties":false,"properties":{"cue":{"type":"string"},"timing":{"type":"string"}},"required":["cue"],"type":"object"},"type":"array"},"music":{"items":{"additionalProperties":false,"properties":{"cue":{"type":"string"},"timing":{"type":"string"}},"required":["cue"],"type":"object"},"type":"array"},"sfx":{"items":{"additionalProperties":false,"properties":{"cue":{"type":"string"},"timing":{"type":"string"}},"required":["cue"],"type":"object"},"type":"array"}},"required":[],"type":"object"},"dialogue_mode":{"enum":["VERBATIM_SCRIPT","SCRIPT_EDIT_REQUESTED"],"type":"string"},"dialogue_rewrite_authorised":{"type":"boolean"},"editing_plan":{"additionalProperties":false,"properties":{"reaction_holds":{"items":{"additionalProperties":false,"properties":{"after_line_id":{"type":"string"},"hold_seconds":{"description":"Reaction-hold length in seconds; strictly positive (a zero-length hold is invalid).","exclusiveMinimum":0,"type":"number"},"purpose":{"type":"string"}},"required":["after_line_id","hold_seconds"],"type":"object"},"type":"array"},"rhythm":{"type":"string"}},"required":[],"type":"object"},"id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"performance_plan_id":{"patte