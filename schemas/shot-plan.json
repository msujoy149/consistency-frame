{"$id":"https://consistencyframe.blogspot.com/schemas/v2.4/shot-plan.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Shot-level plan: camera, framing and lighting per shot, linked to a scene and its beats. Camera choices serve the scene's dramatic intent; they never override the script.","properties":{"id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"project_id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"scene_plan_id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"schema_version":{"enum":["2.4"],"type":"string"},"shots":{"items":{"additionalProperties":false,"properties":{"action":{"type":"string"},"beat_id":{"type":"string"},"camera_angle":{"enum":["eye-level","low","high","birds-eye","dutch","worms-eye"],"type":"string"},"camera_movement":{"enum":["static","pan","tilt","dolly","tracking","crane","handheld","zoom","orbit","aerial-move"],"type":"string"},"character_ids":{"items":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"type":"array"},"duration_seconds":{"minimum":0,"type":"number"},"framing":{"enum":["extreme-wide","wide","full","medium-wide","medium","medium-close-up","close-up","extreme-close-up","over-the-shoulder","two-shot","aerial","insert"],"type":"string"},"lighting":{"type":"string"},"scene_id":{"type":"string"},"shot_id":{"type":"string"}},"required":["shot_id","scene_id","framing"],"type":"object"},"minItems":1,"type":"array"}},"required":["schema_version","id","shots"],"title":"ShotPlan","type":"object"}