{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/character.json",
  "title": "Character",
  "description": "A registered character identity. Voice, wardrobe, props and recurring sounds are separate records linked by ID; they must NOT be embedded here. Media binaries stay in the private overlay; only relative pointers + hashes are stored.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "gender": {
      "type": "string"
    },
    "fixed_identity": {
      "type": "object",
      "properties": {
        "face": {
          "type": "string"
        },
        "eyes": {
          "type": "string"
        },
        "hair": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "distinctive_features": {
          "type": "string"
        }
      },
      "required": [
        "face"
      ],
      "additionalProperties": false
    },
    "reference_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/\\-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "model_sheet": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/\\-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "expression_library": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "style_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "consent": {
      "type": "object",
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "granted_by": {
          "type": "string"
        },
        "granted_at": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "rights_holder",
            "licence",
            "unknown"
          ]
        }
      },
      "required": [
        "granted",
        "source"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "fixed_identity",
    "reference_assets",
    "consent",
    "version",
    "status"
  ],
  "additionalProperties": false
}
