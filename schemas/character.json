{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.5/character.json",
  "title": "Character",
  "description": "A registered character identity. Voice, wardrobe, props and recurring sounds are separate records linked by ID; they must NOT be embedded here. Media binaries stay in the private overlay; only relative pointers + hashes are stored. v2.5 ADDITIVE MIGRATION (CF-WO-P0-006): new fields (subject_kind, species, anatomy_profile, articulation_target, identity_origin, reference_media_provenance, visual_style_profile, voice_profile_ids) are all optional; no existing required field was removed or retyped, so every valid v2.3 record remains valid. Characters are NOT assumed human: subject_kind/species/anatomy describe humans, animals, creatures and digital humans alike, and articulation is always subject-specific (a bird never uses human lip movement).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3",
        "2.5"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "gender": {
      "type": "string"
    },
    "fixed_identity": {
      "type": "object",
      "properties": {
        "face": {
          "type": "string"
        },
        "eyes": {
          "type": "string"
        },
        "hair": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "distinctive_features": {
          "type": "string"
        }
      },
      "required": [
        "face"
      ],
      "additionalProperties": false
    },
    "reference_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/\\-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "model_sheet": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/\\-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "expression_library": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "style_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "subject_kind": {
      "description": "What kind of subject this character is. Never assume human: animals, creatures and digital humans are first-class subjects.",
      "type": "string",
      "enum": [
        "human",
        "digital-human",
        "real-animal",
        "cgi-animal",
        "fictional-creature",
        "anthropomorphic",
        "mixed",
        "non-character"
      ]
    },
    "species": {
      "description": "Species, e.g. 'human' or 'African grey parrot'. Free text so fictional creatures are not forced into a human/animal box.",
      "type": "string"
    },
    "anatomy_profile": {
      "description": "Subject-specific anatomy used to direct performance (what articulates, how it moves). A bird has a beak, not human lips; a creature has its own jaw/mandibles.",
      "type": "object",
      "properties": {
        "body_plan": {
          "type": "string"
        },
        "limbs": {
          "type": "string"
        },
        "articulation_notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "articulation_target": {
      "description": "What articulates when this character speaks or vocalises. Subject-specific: human-mouth-lips only for human/digital-human subjects; bird-beak for birds; animal-muzzle for animals; creature-jaw-mandibles for creatures. Never apply human lip movement to a bird, animal or creature.",
      "type": "string",
      "enum": [
        "human-mouth-lips",
        "bird-beak",
        "animal-muzzle",
        "creature-jaw-mandibles",
        "other"
      ]
    },
    "identity_origin": {
      "description": "Where this character identity came from (provenance of the identity itself, distinct from reference-media provenance).",
      "type": "string",
      "enum": [
        "user-supplied",
        "user-created",
        "licensed",
        "public-domain",
        "fictional-original",
        "unknown"
      ]
    },
    "reference_media_provenance": {
      "description": "Provenance of the reference media this identity was registered from. is_live_action_footage is machine-checkable: false for any generated subject (AI digital human/creature, CGI, drawn) — a generated digital human is NEVER live-action footage.",
      "type": "object",
      "properties": {
        "source_media": {
          "type": "string",
          "enum": [
            "script-only",
            "reference-image",
            "reference-video",
            "captured-footage",
            "generated-image",
            "generated-video",
            "mixed"
          ]
        },
        "is_live_action_footage": {
          "type": "boolean"
        },
        "captured_from": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        },
        "provenance_note": {
          "type": "string"
        }
      },
      "required": [
        "source_media",
        "is_live_action_footage"
      ],
      "additionalProperties": false
    },
    "visual_style_profile": {
      "description": "The visual-style profile this character is registered under (style + medium + motion methods). Inline summary; the full profile lives in visual-style-profile.json.",
      "type": "object",
      "properties": {
        "visual_style": {
          "type": "string",
          "enum": [
            "flat-2d-vector",
            "hand-drawn-2d",
            "illustrated-2d",
            "anime",
            "cartoon-2d",
            "stylized-3d",
            "semi-realistic-3d",
            "photorealistic-3d-cgi",
            "photorealistic-digital-human",
            "photorealistic-digital-animal-creature",
            "mixed"
          ]
        },
        "production_medium": {
          "type": "string",
          "enum": [
            "2d-drawn-vector",
            "3d-cgi-rigged",
            "ai-digital-human",
            "ai-digital-creature",
            "live-action-footage",
            "hybrid-live-action-cgi"
          ]
        },
        "motion_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rig-2d-keyframe",
              "rig-3d-keyframe",
              "ai-image-to-video",
              "ai-video-to-video",
              "motion-capture",
              "performance-transfer",
              "face-animation",
              "body-animation",
              "pose-gesture-transfer",
              "lip-sync-phoneme-viseme",
              "creature-articulation",
              "rotoscoping-compositing"
            ]
          }
        }
      },
      "required": [
        "visual_style"
      ],
      "additionalProperties": false
    },
    "voice_profile_ids": {
      "description": "All voice profiles bound to this character (a character may have more than one voice profile, e.g. per language or register). The default is the first entry; voice data itself is never embedded here — profiles are linked by ID only, and voice use requires explicit consent.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
      }
    },
    "consent": {
      "type": "object",
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "granted_by": {
          "type": "string"
        },
        "granted_at": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "rights_holder",
            "licence",
            "unknown"
          ]
        }
      },
      "required": [
        "granted",
        "source"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "fixed_identity",
    "reference_assets",
    "consent",
    "version",
    "status"
  ],
  "additionalProperties": false
}
