{"$id":"https://consistencyframe.blogspot.com/schemas/v2.4/scene-plan.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Scene-level plan: one entry per scene, each broken into beats with dramatic intent and emotion. Scenes come from the user's script; the plan never rewrites dialogue — dialogue lives in the Performance Plan, verbatim by default.","properties":{"id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"project_id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"scenes":{"items":{"additionalProperties":false,"properties":{"beats":{"items":{"additionalProperties":false,"properties":{"beat_id":{"type":"string"},"description":{"type":"string"},"dramatic_intent":{"minLength":1,"type":"string"},"emotion_intensity":{"minimum":1,"type":"integer"},"emotion_transition":{"type":"string"},"primary_emotion":{"enum":["joy","sadness","anger","fear","surprise","disgust","curiosity","determination","worry","excitement","calm","love","neutral"],"type":"string"},"secondary_emotion":{"enum":["joy","sadness","anger","fear","surprise","disgust","curiosity","determination","worry","excitement","calm","love","neutral","none"],"type":"string"}},"required":["beat_id","dramatic_intent","primary_emotion"],"type":"object"},"minItems":1,"type":"array"},"character_ids":{"items":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"type":"array"},"dramatic_intent":{"minLength":1,"type":"string"},"location_id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"scene_id":{"type":"string"},"title":{"type":"string"},"visual_style_profile_id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"}},"required":["scene_id","dramatic_intent","beats"],"type":"object"},"minItems":1,"type":"array"},"schema_version":{"enum":["2.4"],"type":"string"}},"required":["schema_version","id","scenes"],"title":"ScenePlan","type":"object"}