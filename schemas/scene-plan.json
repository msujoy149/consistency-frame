{
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.5/scene-plan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Scene-level plan: one entry per scene, each broken into beats with dramatic intent and emotion. Scenes come from the user's script; the plan never rewrites dialogue \u2014 dialogue lives in the Performance Plan, verbatim by default. v2.5 ADDITIVE MIGRATION (CF-WO-P0-006): new fields are optional; no existing required field was removed or retyped, so every valid v2.4 record remains valid.",
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$",
      "type": "string"
    },
    "scenes": {
      "items": {
        "additionalProperties": false,
        "description": "One scene. subjects carries the per-subject representation, style, motion and articulation for every character in the scene.",
        "properties": {
          "beats": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "beat_id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "dramatic_intent": {
                  "minLength": 1,
                  "type": "string"
                },
                "emotion_intensity": {
                  "maximum": 10,
                  "minimum": 0,
                  "type": "integer"
                },
                "emotion_transition": {
                  "type": "string"
                },
                "non_verbal_events": {
                  "description": "Explicit non-verbal performance events for this beat/line. Required when the beat/line is non-verbal (no spoken dialogue text): a non-verbal beat/line must carry at least one event here.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "duration_seconds": {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      },
                      "intensity": {
                        "maximum": 10,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "onset": {
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "crying",
                          "sobbing",
                          "laughter",
                          "gasp",
                          "sigh",
                          "silence",
                          "breathing",
                          "trembling",
                          "reaction"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "nuanced_emotion": {
                  "description": "Nuanced emotion, open vocabulary (extensible \u2014 new values need no schema change). Examples: \"bittersweet\", \"wistful\", \"quiet dread\", \"curiosity\", \"determination\", \"worry\", \"excitement\", \"calm\", \"love\". Refines primary_emotion; never replaces it.",
                  "minLength": 1,
                  "type": "string"
                },
                "primary_emotion": {
                  "enum": [
                    "joy",
                    "sadness",
                    "anger",
                    "fear",
                    "surprise",
                    "disgust",
                    "trust",
                    "anticipation",
                    "neutral"
                  ],
                  "type": "string"
                },
                "secondary_emotion": {
                  "enum": [
                    "joy",
                    "sadness",
                    "anger",
                    "fear",
                    "surprise",
                    "disgust",
                    "trust",
                    "anticipation",
                    "neutral",
                    "none"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "beat_id",
                "dramatic_intent",
                "primary_emotion"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "character_ids": {
            "items": {
              "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$",
              "type": "string"
            },
            "type": "array"
          },
          "dramatic_intent": {
            "minLength": 1,
            "type": "string"
          },
          "location_id": {
            "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$",
            "type": "string"
          },
          "scene_id": {
            "type": "string"
          },
          "subjects": {
            "description": "Per-subject details for this scene. Subjects are independent: a human and a talking bird may use different representations, styles and articulation in the same scene.",
            "items": {
              "additionalProperties": false,
              "description": "Per-subject details for this scene/shot. Each subject may use its own representation, source media, rendering style and motion method.",
              "properties": {
                "articulation_target": {
                  "description": "Subject-specific articulation. Never apply human lip movement to a bird, animal or creature.",
                  "enum": [
                    "human-mouth-lips",
                    "bird-beak",
                    "animal-muzzle",
                    "creature-jaw-mandibles",
                    "other"
                  ],
                  "type": "string"
                },
                "character_id": {
                  "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$",
                  "type": "string"
                },
                "contact": {
                  "description": "Physical contact with an object, surface or another character in this scene/shot, e.g. 'hand on the branch'.",
                  "type": "string"
                },
                "continuity": {
                  "description": "Continuity notes for this subject in this scene/shot (position, costume, prop state carried from the previous shot).",
                  "type": "string"
                },
                "eyeline_target": {
                  "description": "What this subject is looking at (character_id, object or direction); drives eyelines and the 180-degree rule.",
                  "type": "string"
                },
                "is_live_action_footage": {
                  "description": "Per-subject provenance: false for any generated subject, even inside a hybrid production.",
                  "type": "boolean"
                },
                "motion_method": {
                  "description": "Motion/generation method for this subject in this scene/shot.",
                  "enum": [
                    "rig-2d-keyframe",
                    "rig-3d-keyframe",
                    "ai-image-to-video",
                    "ai-video-to-video",
                    "motion-capture",
                    "performance-transfer",
                    "face-animation",
                    "body-animation",
                    "pose-gesture-transfer",
                    "lip-sync-phoneme-viseme",
                    "creature-articulation",
                    "rotoscoping-compositing"
                  ],
                  "type": "string"
                },
                "position": {
                  "description": "Position of this subject in the frame/scene, e.g. 'foreground-left'.",
                  "type": "string"
                },
                "rendering_style": {
                  "description": "Rendering style for this subject.",
                  "enum": [
                    "flat-2d-vector",
                    "hand-drawn-2d",
                    "illustrated-2d",
                    "anime",
                    "cartoon-2d",
                    "stylized-3d",
                    "semi-realistic-3d",
                    "photorealistic-3d-cgi",
                    "photorealistic-digital-human",
                    "photorealistic-digital-animal-creature",
                    "mixed"
                  ],
                  "type": "string"
                },
                "representation": {
                  "description": "How this subject is represented (medium).",
                  "enum": [
                    "2d-drawn-vector",
                    "3d-cgi-rigged",
                    "ai-digital-human",
                    "ai-digital-creature",
                    "live-action-footage",
                    "hybrid-live-action-cgi"
                  ],
                  "type": "string"
                },
                "scale": {
                  "description": "Relative scale of this subject, e.g. 'life-size' or '0.8x'.",
                  "type": "string"
                },
                "source_media": {
                  "description": "Source media for this subject.",
                  "enum": [
                    "script-only",
                    "reference-image",
                    "reference-video",
                    "captured-footage",
                    "generated-image",
                    "generated-video",
                    "mixed"
                  ],
                  "type": "string"
                },
                "species": {
                  "description": "Species, e.g. 'African grey parrot'. Needed so articulation can be checked against the subject.",
                  "type": "string"
                },
                "subject_kind": {
                  "description": "What kind of subject this is.",
                  "enum": [
                    "human",
                    "digital-human",
                    "real-animal",
                    "cgi-animal",
                    "fictional-creature",
                    "anthropomorphic",
                    "mixed",
                    "non-character"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "character_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "visual_style_profile_id": {
            "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$",
            "type": "string"
          }
        },
        "required": [
          "scene_id",
          "dramatic_intent",
          "beats"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "enum": [
        "2.4",
        "2.5"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "scenes"
  ],
  "title": "ScenePlan",
  "type": "object"
}
