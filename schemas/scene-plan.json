{"$id":"https://consistencyframe.blogspot.com/schemas/v2.4/scene-plan.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Scene-level plan: one entry per scene, each broken into beats with dramatic intent and emotion. Scenes come from the user's script; the plan never rewrites dialogue \u2014 dialogue lives in the Performance Plan, verbatim by default.","properties":{"id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"project_id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"scenes":{"items":{"additionalProperties":false,"properties":{"beats":{"items":{"additionalProperties":false,"properties":{"beat_id":{"type":"string"},"description":{"type":"string"},"dramatic_intent":{"minLength":1,"type":"string"},"emotion_intensity":{"maximum":10,"minimum":0,"type":"integer"},"emotion_transition":{"type":"string"},"non_verbal_events":{"description":"Explicit non-verbal performance events for this beat/line. Required when the beat/line is non-verbal (no spoken dialogue text): a non-verbal beat/line must carry at least one event here.","items":{"additionalProperties":false,"properties":{"duration_seconds":{"exclusiveMinimum":0,"type":"number"},"intensity":{"maximum":10,"minimum":0,"type":"integer"},"onset":{"type":"string"},"type":{"enum":["crying","sobbing","laughter","gasp","sigh","silence","breathing","trembling","reaction"],"type":"string"}},"required":["type"],"type":"object"},"type":"array"},"nuanced_emotion":{"description":"Nuanced emotion, open vocabulary (extensible \u2014 new values need no schema change). Examples: \"bittersweet\", \"wistful\", \"quiet dread\", \"curiosity\", \"determination\", \"worry\", \"excitement\", \"calm\", \"love\". Refines primary_emotion; never replaces it.","minLength":1,"type":"string"},"primary_emotion":{"enum":["joy","sadness","anger","fear","surprise","disgust","trust","anticipation","neutral"],"type":"string"},"secondary_emotion":{"enum":["joy","sadness","anger","fear","surprise","disgust","trust","anticipation","neutral","none"],"type":"string"}},"required":["beat_id","dramatic_intent","primary_emotion"],"type":"object"},"minItems":1,"type":"array"},"character_ids":{"items":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"type":"array"},"dramatic_intent":{"minLength":1,"type":"string"},"location_id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"},"scene_id":{"type":"string"},"title":{"type":"string"},"visual_style_profile_id":{"pattern":"^[a-z0-9][a-z0-9\\-]{2,63}$","type":"string"}},"required":["scene_id","dramatic_intent","beats"],"type":"object"},"minItems":1,"type":"array"},"schema_version":{"enum":["2.4"],"type":"string"}},"required":["schema_version","id","scenes"],"title":"ScenePlan","type":"object"}
