{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/release-manifest.json",
  "title": "ReleaseManifest",
  "description": "A release manifest: version, branch, full commit, per-file SHA-256 hashes and test results for one package.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "version": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED",
              "NOT RUN"
            ]
          }
        },
        "required": [
          "id",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "generated_at_utc": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "version",
    "branch",
    "commit",
    "files"
  ],
  "additionalProperties": false
}
