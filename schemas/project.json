{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/project.json",
  "title": "Project",
  "description": "A project/series record linking characters, style, story bible and sound assets by stable ID.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3",
        "2.5"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "web_series",
        "short_story",
        "long_form",
        "explainer",
        "documentary",
        "advertising",
        "music_video",
        "live_action",
        "hybrid",
        "one_off"
      ]
    },
    "style_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "story_bible_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "character_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
      }
    },
    "sound_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
      }
    },
    "default_loudness_profile_id": {
      "type": "string"
    },
    "identity_policy_id": {
      "description": "Identity-selection policy for this project (CF-WO-P1-004-R1-ADDENDUM-IDENTITY, Task B/C): id of the identity-selection-policy record (schemas/identity-selection-policy.json) that governs which registered characters and voices this project may use. Optional; a project without one has no identity policy and resolves identities only through an explicit per-job policy. A v2.3 project record without this field remains valid.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "owner": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "archived"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "version",
    "status"
  ],
  "additionalProperties": false
}
