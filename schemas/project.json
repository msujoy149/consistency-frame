{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/project.json",
  "title": "Project",
  "description": "A project/series record linking characters, style, story bible and sound assets by stable ID.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "web_series",
        "short_story",
        "long_form",
        "explainer",
        "documentary",
        "advertising",
        "music_video",
        "live_action",
        "hybrid",
        "one_off"
      ]
    },
    "style_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "story_bible_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "character_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
      }
    },
    "sound_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
      }
    },
    "default_loudness_profile_id": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed",
        "archived"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "version",
    "status"
  ],
  "additionalProperties": false
}
