{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/reference-learning.json",
  "title": "ReferenceLearning",
  "description": "A learning candidate lifecycle record. REFERENCE_LEARN_AND_UPDATE only: requires explicit user instruction; status moves OBSERVED -> CANDIDATE -> VALIDATED -> ACCEPTED -> DEPRECATED.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "reference_id": {
      "type": "string"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "rule_text": {
          "type": "string"
        },
        "owner_skill": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "global",
            "project",
            "character",
            "scene",
            "shot"
          ]
        },
        "source_timecodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "duplicate_check": {
          "type": "string"
        },
        "conflict_check": {
          "type": "string"
        }
      },
      "required": [
        "rule_text",
        "owner_skill",
        "scope"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "CANDIDATE",
        "VALIDATED",
        "ACCEPTED",
        "DEPRECATED"
      ]
    },
    "explicit_user_instruction": {
      "type": "boolean"
    },
    "validation_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "reference_id",
    "candidate",
    "status",
    "explicit_user_instruction"
  ],
  "additionalProperties": false
}
