{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/voice-profile.json",
  "title": "VoiceProfile",
  "description": "A character voice profile. Separate from character identity and from sound assets. Requires explicit authorisation + rights/consent.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "provider": {
      "type": "string"
    },
    "provider_voice_id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "reference_audio": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/\\-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "delivery_traits": {
      "type": "string"
    },
    "use_scope": {
      "type": "string"
    },
    "consent": {
      "type": "object",
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "granted_by": {
          "type": "string"
        },
        "granted_at": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "rights_holder",
            "licence",
            "unknown"
          ]
        }
      },
      "required": [
        "granted",
        "source"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "character_id",
    "reference_audio",
    "consent",
    "version",
    "status"
  ],
  "additionalProperties": false
}
