{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/installer-result.json",
  "title": "InstallerResult",
  "description": "A machine-readable installer/sync result: one truthful status per component; overall must match the exit code (0=SUCCESS, 2=PARTIAL, 1=FAILED).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "PARTIAL",
              "FAILED",
              "SKIPPED"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "overall": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "FAILED"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "timestamp_utc": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "components",
    "overall",
    "exit_code"
  ],
  "additionalProperties": false
}
