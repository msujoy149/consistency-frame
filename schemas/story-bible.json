{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/story-bible.json",
  "title": "StoryBible",
  "description": "A story bible: premise, world rules, character arcs and tone for a project/series.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "premise": {
      "type": "string"
    },
    "world_rules": {
      "type": "string"
    },
    "character_arcs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tone": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "title",
    "version",
    "status"
  ],
  "additionalProperties": false
}
