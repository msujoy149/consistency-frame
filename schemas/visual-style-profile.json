{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consistencyframe.blogspot.com/schemas/v2.3/visual-style-profile.json",
  "title": "VisualStyleProfile",
  "description": "A locked visual style for a project/series. Identity stays fixed; style is project-scoped.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "medium": {
      "type": "string",
      "enum": [
        "2d_animation",
        "3d_animation",
        "stylised",
        "explainer",
        "realistic_person",
        "live_action",
        "hybrid"
      ]
    },
    "realism": {
      "type": "string",
      "enum": [
        "cartoon",
        "stylised",
        "photorealistic",
        "documentary"
      ]
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lighting": {
      "type": "string"
    },
    "texture": {
      "type": "string"
    },
    "camera_language": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "render_constraints": {
      "type": "string"
    },
    "reference_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "medium",
    "version",
    "status"
  ],
  "additionalProperties": false
}
